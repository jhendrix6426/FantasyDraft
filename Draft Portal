let playerNatsData = {};
// dailyPoolPts[yr][day] = [pts,...] for pool avg
let dailyPoolPts = {};

function normName(n) {
  return n.toLowerCase().trim().replace(/\s+/g,' ')
    .replace(/\bmitch\b/,'mitchell')
    .replace(/jayden alstand/,'jayden alstad')
    .replace(/dario dante villanova/,'dario dante villanova')
    .replace(/^dario villanova$/,'dario dante villanova');
}
function namesMatch(a,b) {
  const na=normName(a), nb=normName(b);
  if(na===nb) return true;
  const pa=na.split(' '), pb=nb.split(' ');
  if(pa.length<2 || pb.length<2) return false;
  // Last names must match exactly
  if(pa[pa.length-1] !== pb[pb.length-1]) return false;
  // First names must match exactly OR one must start with the other
  // (handles Mitch/Mitchell, etc.) but NOT partial last-name-only matches
  const fa=pa[0], fb=pb[0];
  return fa===fb || fa.startsWith(fb) || fb.startsWith(fa);
}

function avg(arr) { return arr.length ? arr.reduce((s,v)=>s+v,0)/arr.length : null; }
function r1(n) { return n!==null ? Math.round(n*10)/10 : null; }

// Pre-computed fantasy stats: {name: {avgPick, avgPts, appearances, avgDelta}}
const fantasyStats = {};

function buildFantasyStats() {
  for (const p of PLAYERS) {
    const entries = [];
    for (const [yr, data] of Object.entries(DD)) {
      for (const team of data.teams) {
        const pick = team.players.find(pk => namesMatch(pk.name, p.name));
        if (!pick) continue;
        // 2-round window delta
        const allPicks = data.teams.flatMap(t=>t.players).sort((a,b)=>a.pick-b.pick);
        const total = allPicks.length;
        const wStart = Math.max(1, pick.pick-4);
        const wEnd = Math.min(total, Math.max(wStart+7, pick.pick+3));
        const window = allPicks.filter(pk=>pk.pick>=wStart&&pk.pick<=wEnd&&!namesMatch(pk.name,p.name));
        const windowAvg = window.length ? avg(window.map(pk=>pk.pts)) : pick.pts;
        const delta = r1(pick.pts - windowAvg);
        entries.push({yr:parseInt(yr), pts:pick.pts, pick:pick.pick, delta, gm:team.gm});
      }
    }
    if (entries.length) {
      fantasyStats[p.name] = {
        appearances: entries.length,
        avgPick: r1(avg(entries.map(e=>e.pick))),
        avgPts: r1(avg(entries.map(e=>e.pts))),
        avgDelta: r1(avg(entries.map(e=>e.delta))),
        entries
      };
    }
  }
}

