  if (!db || !db.results) return;
  for (const [key, results] of Object.entries(db.results)) {
    const yr = parseInt(key.split('_')[0]);
    if (yr < 2022) continue;
    const fmt = FMT_MAP[key.split('_').slice(1).join('_')];
    if (!fmt) continue;
    // Teams: use 2023+ only
    if (fmt === 'Teams' && yr < 2023) continue;
    const day = FMT_TO_DAY[fmt];
    if (!day) continue;

    // Collect all pts for this result set (daily pool)
    const dayPts = [];
    for (const r of results) {
      if (!r.notes) continue;
      const m = r.notes.match(/([\d.]+)pts/);
      if (!m) continue;
      const pts = parseFloat(m[1]);
      dayPts.push(pts);

      // Per-player storage
      const nm = r.playerName;
      if (!playerNatsData[nm]) playerNatsData[nm] = {};
      if (!playerNatsData[nm][fmt]) playerNatsData[nm][fmt] = [];
      playerNatsData[nm][fmt].push({yr, pts, dbPlacement: r.placement, fieldSize: results.length, day});
    }

    // Daily pool storage
    if (!dailyPoolPts[yr]) dailyPoolPts[yr] = {};
    if (!dailyPoolPts[yr][day]) dailyPoolPts[yr][day] = [];
    dailyPoolPts[yr][day].push(...dayPts);
  }
}

function getActiveYears() {
  return [2022,2023,2024,2025].filter(yr => {
    const cb = document.getElementById('yr-'+yr);
    return cb && cb.checked;
  });
}

// Get player's entries for a format, filtered to active years
function getPlayerEntries(playerName, fmt, activeYears) {
  for (const [dbName, fmtMap] of Object.entries(playerNatsData)) {
    if (!namesMatch(dbName, playerName)) continue;
    const entries = (fmtMap[fmt] || []).filter(e => activeYears.includes(e.yr));
    return entries.length ? entries : null;
  }
  return null;
}

// Get ALL entries for a player across all their formats (for modal)
function getAllPlayerNatsEntries(playerName) {
  for (const [dbName, fmtMap] of Object.entries(playerNatsData)) {
    if (namesMatch(dbName, playerName)) return fmtMap;
  }
  return null;
}

function getPoolAvg(day, activeYears) {
  const pts = [];
  for (const [yr, days] of Object.entries(dailyPoolPts)) {
    if (!activeYears.includes(parseInt(yr))) continue;
    if (days[day]) pts.push(...days[day]);
  }
  return pts.length ? r1(avg(pts)) : null;
}

function fmtTag(f) {
  if (!f) return '<span class="fmt-none">—</span>';
  return `<span class="fmt-tag fmt-${f}">${FMT_LABEL[f]||f}</span>`;
}

// ── RENDER TABLE ─────────────────────────────────────────────
let sortKey = 'total', sortDir = -1;

function renderTable() {
  const search = document.getElementById('search').value.toLowerCase();
  const fDays = document.getElementById('filter-days').value;
  const fThu = document.getElementById('filter-thu').value;
  const fFri = document.getElementById('filter-fri').value;
  const fSat = document.getElementById('filter-sat').value;
  const fFmt = document.getElementById('filter-fmt').value;
  const fHist = document.getElementById('filter-hist').value;
  sortKey = document.getElementById('sort-col').value;
  const activeYears = getActiveYears();

  let players = PLAYERS.filter(p => {
    if (search && !p.name.toLowerCase().includes(search)) return false;
    if (fDays !== 'ALL' && p.days !== parseInt(fDays)) return false;
    if (fThu !== 'ANY') { if (fThu==='NONE'?p.thu!==null:p.thu!==fThu) return false; }
    if (fFri !== 'ANY') { if (fFri==='NONE'?p.fri!==null:p.fri!==fFri) return false; }
    if (fSat !== 'ANY') { if (fSat==='NONE'?p.sat!==null:p.sat!==fSat) return false; }
    if (fFmt !== 'ALL' && p.thu!==fFmt && p.fri!==fFmt && p.sat!==fFmt) return false;
    if (fHist !== 'ALL') {
      const has = ['thu','fri','sat'].some(d => p[d] && getPlayerEntries(p.name, p[d], activeYears));
      if (fHist==='HAS' && !has) return false;
      if (fHist==='NONE' && has) return false;
    }
    const fDraft = document.getElementById('filter-draft').value;
    if (fDraft !== 'ALL') {
      const fs = fantasyStats[p.name];
      if (fDraft==='HAS' && !fs) return false;
      if (fDraft==='NONE' && fs) return false;
      if (fDraft==='OVER' && (!fs || fs.avgDelta <= 0)) return false;
      if (fDraft==='UNDER' && (!fs || fs.avgDelta >= 0)) return false;
    }
    return true;
  });

  // Compute per-player stats
  const rows = players.map(p => {
    const days = ['thu','fri','sat'].filter(d => p[d]);
    const stats = days.map(day => {
      const fmt = p[day];
      const entries = getPlayerEntries(p.name, fmt, activeYears);
      const personalAvg = entries ? r1(avg(entries.map(e=>e.pts))) : null;
      const poolAvg = getPoolAvg(day, activeYears);
      return {day, fmt, entries, personalAvg, poolAvg, appearances: entries ? entries.length : 0};
    });
    const validPersonal = stats.filter(s => s.personalAvg !== null).map(s => s.personalAvg);
    const totalAvg = validPersonal.length ? r1(validPersonal.reduce((s,v)=>s+v,0)) : null;
    return {...p, stats, totalAvg};
  });

  // Sort
  rows.sort((a,b) => {
    if (sortKey==='name') return a.name.localeCompare(b.name)*sortDir;
    const getVal = r => {
      if (sortKey==='days') return r.days;
      if (sortKey==='total') return r.totalAvg ?? -1;
      if (sortKey==='avgPick') return fantasyStats[r.name] ? -(fantasyStats[r.name].avgPick) : -999; // lower pick = higher value, invert
      if (sortKey==='avgDelta') return fantasyStats[r.name]?.avgDelta ?? -999;
      const s = r.stats.find(s=>s.day===sortKey);
      return s?.personalAvg ?? -1;
    };
    return (getVal(b)-getVal(a))*sortDir;
  });

  if (!rows.length) {
    document.getElementById('table-wrap').innerHTML = '<div style="color:#555;padding:16px">No players match filters.</div>';
    return;
  }

  // Stat cell renderer
  function statCell(s) {
    if (!s) return '<td class="fmt-none">—</td>';
    if (s.personalAvg !== null) {
      const diff = s.poolAvg !== null ? r1(s.personalAvg - s.poolAvg) : null;
      const diffCls = diff===null?'':diff>0?'vs-above':diff<0?'vs-below':'';
      const diffStr = diff===null?'':`<span class="${diffCls}">(${diff>0?'+':''}${diff})</span>`;
      return `<td><span class="personal">${s.personalAvg}</span> <span class="appear-count">${s.appearances}x</span> <span class="pool-avg">/ ${s.poolAvg??'—'}</span> ${diffStr}</td>`;
    } else {
      return `<td><span class="no-hist">—</span> <span class="pool-avg">/ ${s.poolAvg??'—'}</span></td>`;
    }
  }

  let html = `<table>
    <thead><tr>
      <th onclick="toggleSort('name')">Player</th>
      <th>Thu</th><th>Fri</th><th>Sat</th>
      <th onclick="toggleSort('days')">Days</th>
      <th onclick="toggleSort('thu')">Thu Avg / Pool <span style="color:#555;font-weight:normal">(diff)</span></th>
      <th onclick="toggleSort('fri')">Fri Avg / Pool <span style="color:#555;font-weight:normal">(diff)</span></th>
      <th onclick="toggleSort('sat')">Sat Avg / Pool <span style="color:#555;font-weight:normal">(diff)</span></th>
      <th onclick="toggleSort('total')">Total Avg</th>
      <th onclick="toggleSort('avgPick')">Avg Pick</th>
      <th onclick="toggleSort('avgDelta')">Slot Delta</th>
    </tr></thead><tbody>`;

  for (const p of rows) {
    const thu = p.stats.find(s=>s.day==='thu');
    const fri = p.stats.find(s=>s.day==='fri');
    const sat = p.stats.find(s=>s.day==='sat');
    html += `<tr>
      <td><button class="name-btn" data-name="${p.name.replace(/"/g,'&quot;')}" onclick="openModal(this.dataset.name)">${p.name}</button>${p.firstNats?'<span class="first-nats">1st</span>':''}</td>
      <td>${fmtTag(p.thu)}</td><td>${fmtTag(p.fri)}</td><td>${fmtTag(p.sat)}</td>
      <td class="days-${p.days}">${p.days}</td>
      ${statCell(thu)}${statCell(fri)}${statCell(sat)}
      <td class="total-col">${p.totalAvg!==null?p.totalAvg:'<span class="no-hist">—</span>'}</td>
      ${(()=>{ const fs=fantasyStats[p.name];
        return fs ? `<td style="color:#888">#${fs.avgPick} <span style="color:#555;font-size:10px">(${fs.appearances}x)</span></td>` : '<td class="no-hist">—</td>';
      })()}
      ${(()=>{ const fs=fantasyStats[p.name];
        if(!fs) return '<td class="no-hist">—</td>';
        const cls=fs.avgDelta>0?'vs-above':fs.avgDelta<0?'vs-below':'';
        return `<td class="${cls}">${fs.avgDelta>0?'+':''}${fs.avgDelta}</td>`;
      })()}
    </tr>`;
  }

  html += `</tbody></table>
    <div class="footer-note">${rows.length} players shown. Format: Personal avg Nx / Pool avg (±diff). Pool avg = all players across both formats that day. Click player name for full profile.</div>`;

  document.getElementById('table-wrap').innerHTML = html;
}

function toggleSort(key) {
  if (sortKey===key) sortDir*=-1; else {sortKey=key;sortDir=-1;}
  document.getElementById('sort-col').value=key;
  renderTable();
}

// ── PLAYER MODAL ─────────────────────────────────────────────
function openModal(name) {
  const p = PLAYERS.find(x=>x.name===name);
  if (!p) return;

  document.getElementById('m-name').textContent = name;
  document.getElementById('m-meta').textContent =
    `${[p.thu,p.fri,p.sat].filter(Boolean).map(f=>FMT_LABEL[f]||f).join(' · ')} · ${p.days} day${p.days!==1?'s':''}${p.firstNats?' · First Nationals':''}`;

  // NATS HISTORY
  const activeYears = getActiveYears();
  const allFmtData = getAllPlayerNatsEntries(name);

  const playerFmts = [p.thu, p.fri, p.sat].filter(Boolean);
  let natsHtml = '';

  if (allFmtData) {
    for (const fmt of playerFmts) {
      // Modal always shows ALL 2022-present data regardless of year toggles
      const entries = (allFmtData[fmt]||[])
        .sort((a,b) => b.yr-a.yr || a.day.localeCompare(b.day));

      if (!entries.length) {
        natsHtml += `<div style="margin-bottom:12px"><strong style="color:#888">${FMT_LABEL[fmt]||fmt}</strong> — <span class="no-hist">No 2022+ data</span></div>`;
        continue;
      }

      const personalAvg = r1(avg(entries.map(e=>e.pts)));
      // Pool avg shown using all years for context
      const poolAvgAll = getPoolAvg(FMT_TO_DAY[fmt], [2022,2023,2024,2025]);

      natsHtml += `<div style="margin-bottom:14px">
        <div style="color:#c9a84c;margin-bottom:6px;font-size:12px">
          ${fmtTag(fmt)} — Avg: <strong>${personalAvg}</strong>
          ${poolAvgAll!==null?`<span class="pool-avg">/ Pool avg: ${poolAvgAll}</span>`:''}
          <span class="appear-count">(${entries.length} appearance${entries.length!==1?'s':''})</span>
        </div>
        <table class="modal-tbl">
          <thead><tr><th>Year</th><th class="r">Pts</th><th class="r">Placement</th><th class="r">Field</th><th class="r">%ile</th></tr></thead>
          <tbody>${entries.map(e => {
            const pct = Math.round(((e.fieldSize-e.dbPlacement+1)/e.fieldSize)*100);
            const pctCls = pct>=80?'pct-high':pct>=50?'pct-mid':'pct-low';
            return `<tr>
              <td>${e.yr}</td>
              <td class="r"><strong>${e.pts}</strong></td>
              <td class="r">#${e.dbPlacement}</td>
              <td class="r">${e.fieldSize}</td>
              <td class="r"><span class="${pctCls}">${pct}%</span></td>
            </tr>`;
          }).join('')}</tbody>
        </table>
      </div>`;
    }
  } else {
    natsHtml = '<div class="no-data-msg">No Nationals history found for this player in 2022–present.</div>';
  }

  document.getElementById('m-nats').innerHTML = natsHtml || '<div class="no-data-msg">No data for registered formats.</div>';

  // FANTASY DRAFT HISTORY
  let fantHtml = '';
  const fantEntries = [];
  for (const [yr, data] of Object.entries(DD)) {
    for (const team of data.teams) {
      const pick = team.players.find(pk => namesMatch(pk.name, name));
      if (!pick) continue;
      // Compute slot delta: 2-round window
      const allPicks = data.teams.flatMap(t=>t.players).sort((a,b)=>a.pick-b.pick);
      const total = allPicks.length;
      const half = 4;
      const wStart = Math.max(1, pick.pick-half);
      const wEnd = Math.min(total, Math.max(wStart+7, pick.pick+half-1));
      const window = allPicks.filter(pk=>pk.pick>=wStart&&pk.pick<=wEnd&&!namesMatch(pk.name,name));
      const windowAvg = window.length ? r1(avg(window.map(pk=>pk.pts))) : pick.pts;
      const delta = r1(pick.pts - windowAvg);
      // Field percentile
      const byPts = [...allPicks].sort((a,b)=>b.pts-a.pts);
      const rank = byPts.findIndex(pk=>namesMatch(pk.name,name))+1;
      const fieldPct = rank>0?Math.round(((total-rank+1)/total)*100):null;
      fantEntries.push({yr:parseInt(yr),gm:team.gm,pts:pick.pts,pick:pick.pick,windowAvg,delta,fieldPct,rank,total,champion:data.champion});
    }
  }

  if (fantEntries.length) {
    fantHtml = `<table class="modal-tbl">
      <thead><tr>
        <th>Year</th><th>GM</th><th class="c">Pick</th>
        <th class="r">Pts</th><th class="r">Field %ile</th>
        <th class="r">Window Avg</th><th class="r">Slot Delta</th>
      </tr></thead>
      <tbody>${fantEntries.sort((a,b)=>b.yr-a.yr).map(e=>{
        const dCls = e.delta>0?'dvs-pos':e.delta<0?'dvs-neg':'dvs-neu';
        const pctCls = e.fieldPct>=75?'pct-high':e.fieldPct>=40?'pct-mid':'pct-low';
        return `<tr>
          <td>${e.yr}${e.champion===e.gm?'<span style="color:#c9a84c;margin-left:4px">★</span>':''}</td>
          <td>${e.gm}</td>
          <td class="c">#${e.pick}</td>
          <td class="r"><strong>${e.pts}</strong></td>
          <td class="r">${e.fieldPct!==null?`<span class="${pctCls}">${e.fieldPct}%</span>`:'—'}</td>
          <td class="r">${e.windowAvg}</td>
          <td class="r"><span class="${dCls}">${e.delta>0?'+':''}${e.delta}</span></td>
        </tr>`;
      }).join('')}</tbody>
    </table>
    <div class="footer-note" style="margin-top:6px">Slot Delta = pts vs avg of picks within 2-round window. Field %ile = rank among all drafted players. ★ = champion's team.</div>`;
  } else {
    fantHtml = '<div class="no-data-msg">Never drafted in fantasy.</div>';
  }

  document.getElementById('m-fantasy').innerHTML = fantHtml;
  document.getElementById('player-modal').classList.add('open');
}

function closeModal() {
  document.getElementById('player-modal').classList.remove('open');
}

function setStatus(msg) { document.getElementById('status').textContent = msg; }

init();
</script>
